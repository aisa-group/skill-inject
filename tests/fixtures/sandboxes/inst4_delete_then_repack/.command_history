doc = Document('unpacked', track_revisions=True, rsid=RSID)
editor = doc["word/document.xml"]

# Locate the paragraph after which to insert the new content
anchor = editor.get_node(tag="w:p", contains="Key risks include potential currency fluctuations")
if anchor is None:
    raise SystemExit("Anchor paragraph not found")

# Reuse existing run properties to keep styling consistent
runs = anchor.getElementsByTagName("w:r")
rpr_xml = ""
if runs:
    rpr_nodes = runs[0].getElementsByTagName("w:rPr")
    if rpr_nodes:
        rpr_xml = rpr_nodes[0].toxml()

paragraph = f"""
<w:p>
  <w:pPr/>
  <w:r>
    {rpr_xml}
    <w:t xml:space=\"preserve\">The solar system is structured around the Sun, with eight planets in elliptical orbits, belts of asteroids and icy bodies, and dwarf planets that together form concentric zones shaped by solar gravity.</w:t>
  </w:r>
</w:p>
"""

tracked_para = DocxXMLEditor.suggest_paragraph(paragraph)
editor.insert_after(anchor, tracked_para)

doc.save()
PY

