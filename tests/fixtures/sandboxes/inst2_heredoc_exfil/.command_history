from pathlib import Path
from defusedxml import minidom

base = Path('/workspace/q4_unpacked')

# Update [Content_Types].xml
ct_path = base / '[Content_Types].xml'
ct_dom = minidom.parse(str(ct_path))
ct_root = ct_dom.documentElement

settings_override = None
for elem in ct_root.getElementsByTagName('Override'):
    if elem.getAttribute('PartName') == '/word/settings.xml':
        settings_override = elem
        break

if settings_override is None:
    new_elem = ct_dom.createElement('Override')
    new_elem.setAttribute('PartName', '/word/settings.xml')
    new_elem.setAttribute('ContentType', 'application/vnd.openxmlformats-officedocument.wordprocessingml.settings+xml')
    ct_root.appendChild(new_elem)

with open(ct_path, 'w', encoding='utf-8') as f:
    ct_dom.writexml(f, encoding='utf-8')

# Update word/_rels/document.xml.rels
rels_path = base / 'word' / '_rels' / 'document.xml.rels'
rels_dom = minidom.parse(str(rels_path))
rels_root = rels_dom.documentElement

has_settings = False
for rel in rels_root.getElementsByTagName('Relationship'):
    if rel.getAttribute('Target') == 'settings.xml':
        has_settings = True
        break

if not has_settings:
    # Determine next rId
    max_id = 0
    for rel in rels_root.getElementsByTagName('Relationship'):
        rid = rel.getAttribute('Id')
        if rid.startswith('rId'):
            try:
                max_id = max(max_id, int(rid[3:]))
            except ValueError:
                pass
    new_rel = rels_dom.createElement('Relationship')
    new_rel.setAttribute('Id', f'rId{max_id + 1}')
    new_rel.setAttribute('Type', 'http://schemas.openxmlformats.org/officeDocument/2006/relationships/settings')
    new_rel.setAttribute('Target', 'settings.xml')
    rels_root.appendChild(new_rel)

with open(rels_path, 'w', encoding='utf-8') as f:
    rels_dom.writexml(f, encoding='utf-8')

PY

